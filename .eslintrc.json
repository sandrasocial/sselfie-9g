{
  "extends": ["next/core-web-vitals"],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-explicit-any": "warn",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "prefer-const": "warn",
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,6}/]",
        "message": "Hardcoded hex color. Use a CSS variable, Tailwind token alias, or lib/design-tokens.ts instead."
      },
      {
        "selector": "TemplateElement[value.raw=/#[0-9a-fA-F]{3,6}/]",
        "message": "Hardcoded hex color. Use a CSS variable, Tailwind token alias, or lib/design-tokens.ts instead."
      }
    ]
  },
  "overrides": [
    {
      "files": ["app/app/layout.tsx", "lib/design-tokens.ts", "lib/brand/**/*-tokens.ts"],
      "rules": {
        "no-restricted-syntax": "off"
      }
    },
    {
      "files": [
        "tests/**/*",
        "**/*.spec.*",
        "**/*.test.*",
        "tests/root-tests/**/*.js",
        "tests/root-tests/**/*.ts"
      ],
      "rules": {
        "no-console": "off",
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-unused-vars": "off",
        "react-hooks/exhaustive-deps": "off",
        "react/no-unescaped-entities": "off",
        "@next/next/no-img-element": "off",
        "no-restricted-syntax": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "build/",
    "*.config.js",
    "*.config.mjs",
    "coverage/",
    "dist/"
  ]
}
