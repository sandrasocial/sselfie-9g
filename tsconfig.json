{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES2018",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/actions/**/*.ts",
    "app/actions/**/*.tsx",
    "app/api/stripe/**/*.ts",
    "app/api/webhooks/stripe/**/*.ts",
    "lib/db*.ts",
    "lib/user-mapping.ts",
    "lib/credits.ts",
    "lib/stripe.ts",
    "lib/email/send-email.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/**",
    "scripts",
    "tests"
  ]
}
